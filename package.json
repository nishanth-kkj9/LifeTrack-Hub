{
  "name": "lifetrack-hub",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "tsx test/browser_ui_workflows.test.ts && tsx test/firestore.rules.emulator.test.ts && tsx test/stability_corrupted_data.test.ts && tsx test/academics_vtu_logic.test.ts && tsx test/sync_merge.test.ts && tsx test/server_production.test.ts && tsx test/tasks_habits_logic.test.ts",
    "test:ui": "tsx test/browser_ui_workflows.test.ts",
    "test:rules": "tsx test/firestore.rules.emulator.test.ts",
    "test:firebase": "firebase emulators:exec --project demo-lifetrack --only firestore 'tsx test/firestore.rules.emulator.test.ts'",
    "test:stability": "tsx test/stability_corrupted_data.test.ts"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.19.0",
    "helmet": "^8.3.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^4.17.21",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
